<%- include("partials/header.ejs") %>

<div class="container">
<h1>Contact Me</h1>
<% if (staticPages) { %>
  <div class="alert alert-info" role="status">
    Demo only: this form validates in your browser but does not send or store messages.
  </div>
<% } %>
<form method="POST" action="<%= staticPages ? '#' : '/submit' %>" <% if (staticPages) { %>data-demo-form="contact"<% } %>>
  <% if (locals.error) { %>
    <div class="error-popup">
      <span class="error-icon">&#9888;</span>
      <%= error %>
      <span class="close-btn" onclick="this.parentElement.style.display='none';">&times;</span>
    </div>
  <% } %>
  <input name="name" type="text" class="feedback-input" placeholder="Name" aria-label="Name" required maxlength="100" />
  <input name="email" type="email" class="feedback-input" placeholder="Email" aria-label="Email" required maxlength="254" />
  <textarea name="comment-text" class="feedback-input" placeholder="Comment" aria-label="Comment" required maxlength="2000"></textarea>
  <input type="submit" class="submit-btn" value="SUBMIT" />
  <% if (staticPages) { %>
    <p class="alert alert-info mt-3" data-demo-status role="status" aria-live="polite" hidden></p>
  <% } %>
</form>
</div>


<%- include("partials/footer.ejs") %>